*{box-sizing:border-box;margin:0;padding:0}
@property --spin{syntax:'<angle>';inherits:false;initial-value:0deg}
:root{--ease:cubic-bezier(.22,1,.36,1);--spring:cubic-bezier(.34,1.56,.64,1)}
html{scroll-behavior:smooth}
html[data-theme=light]{--bg:#fff;--fg:#111;--mut:#777;--card:#f5f5f5;--line:#e5e5e5;--acc:#111;--accs:#111;--accfg:#fff;--shadow:0 14px 34px rgba(0,0,0,.12);
  --g1:rgba(255,255,255,.78);--g2:rgba(255,255,255,.38);--ghi:rgba(255,255,255,1);--glo:rgba(0,0,0,.05);--gin:rgba(255,255,255,.45);--gsh:rgba(30,30,50,.14);--gsp:rgba(255,255,255,.95);--grim:rgba(255,255,255,1);--grim2:rgba(0,0,0,.10);--gb:20px;--lens1:rgba(0,0,0,.09);--lens2:rgba(0,0,0,.03)}
html[data-theme=dark]{--bg:#000;--fg:#f2f2f4;--mut:#8f8f98;--card:rgba(255,255,255,.05);--line:rgba(255,255,255,.14);--acc:linear-gradient(135deg,#f4f4f6,#9d9da6);--accs:#c4c4cc;--accfg:#111;--shadow:0 14px 44px rgba(255,255,255,.08);
  --g1:rgba(255,255,255,.11);--g2:rgba(255,255,255,.025);--ghi:rgba(255,255,255,.38);--glo:rgba(255,255,255,.06);--gin:rgba(255,255,255,.05);--gsh:rgba(0,0,0,.55);--gsp:rgba(255,255,255,.24);--grim:rgba(255,255,255,.8);--grim2:rgba(255,255,255,.28);--gb:22px;--lens1:rgba(255,255,255,.24);--lens2:rgba(255,255,255,.07)}

body{font-family:'Space Grotesk','Cairo',sans-serif;background:var(--bg);color:var(--fg);min-height:100vh;overflow-x:hidden;transition:background .5s,color .5s;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
input,textarea{-webkit-user-select:text;user-select:text}
img{-webkit-user-drag:none}
html[lang=ar] body{font-family:'Cairo','Space Grotesk',sans-serif}
button,input,select,textarea{font:inherit;color:inherit}
a{color:inherit;text-decoration:none}
.hidden{display:none!important}
.muted{color:var(--mut)}
.defs{position:absolute;width:0;height:0;pointer-events:none}

#stars{position:fixed;inset:0;width:100%;height:100%;z-index:0;opacity:0;transition:opacity .9s;pointer-events:none}
html[data-theme=dark] #stars{opacity:1}
#glow{position:fixed;left:0;top:0;width:420px;height:420px;margin:-210px 0 0 -210px;border-radius:50%;pointer-events:none;z-index:0;background:radial-gradient(circle,rgba(0,0,0,.05),transparent 62%);will-change:transform}
html[data-theme=dark] #glow{background:radial-gradient(circle,rgba(255,255,255,.08),transparent 62%)}

.top,.hero,.marquee,main,footer{position:relative;z-index:1}

/* ================= LIQUID GLASS ================= */
.glass{position:relative;background:linear-gradient(135deg,var(--g1),var(--g2));
  -webkit-backdrop-filter:blur(var(--gb)) saturate(180%) brightness(1.08);backdrop-filter:blur(var(--gb)) saturate(180%) brightness(1.08);
  box-shadow:inset 0 1px 0 var(--ghi),inset 0 -1px 0 var(--glo),inset 0 0 24px var(--gin),0 12px 36px var(--gsh)}
.glass.lite{-webkit-backdrop-filter:none;backdrop-filter:none;box-shadow:inset 0 1px 0 var(--ghi),inset 0 -1px 0 var(--glo),inset 0 0 18px var(--gin),0 6px 18px var(--gsh)}
.glass::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:0;
  background:radial-gradient(180px circle at var(--mx,25%) var(--my,0%),var(--gsp),transparent 70%);opacity:.85;transition:opacity .4s}
.glass::after{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.2px;pointer-events:none;z-index:3;
  background:conic-gradient(from calc(var(--ang,210deg) + var(--spin,0deg)),var(--grim),transparent 22%,var(--grim2) 50%,transparent 72%,var(--grim));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}

/* header */
.top{position:sticky;top:10px;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:10px;margin:10px 3vw 0;padding:9px 12px 9px 24px;border-radius:999px}
.logo{font-weight:700;font-size:22px;letter-spacing:3px;position:relative;z-index:1}
.logo span{margin-inline-start:4px;opacity:.55;transition:.4s}
.logo:hover span{opacity:1;letter-spacing:6px}
html[data-theme=dark] .logo span{background:var(--acc);-webkit-background-clip:text;background-clip:text;color:transparent;opacity:1}
.top nav a{margin:0 14px;font-size:15px;position:relative;z-index:1}
.top nav a::after{content:"";position:absolute;left:0;bottom:-4px;height:2px;width:0;background:var(--accs);transition:width .4s var(--ease)}
.top nav a:hover::after{width:100%}
.tools{display:flex;gap:8px;position:relative;z-index:1}

.pill{min-width:42px;height:42px;padding:0 14px;border-radius:999px;border:none;cursor:pointer;display:grid;place-items:center;position:relative;overflow:hidden;transition:transform .35s var(--spring),box-shadow .3s}
.pill:hover{transform:scale(1.08)}
.pill:active{transform:scale(.9)}
.ico{display:inline-block;font-size:18px;transition:transform .6s var(--ease);position:relative;z-index:1}
#themeBtn:hover .ico{transform:rotate(180deg) scale(1.2)}
.cwrap{font-size:14px;font-weight:600;white-space:nowrap}
.cwrap span{position:relative;z-index:1}
.cwrap select{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;border:0;padding:0;z-index:4}
.count{position:absolute;top:3px;inset-inline-end:3px;min-width:18px;height:18px;border-radius:9px;background:#ff3b5c;color:#fff;font-size:11px;display:grid;place-items:center;padding:0 4px;transform:scale(0);transition:transform .4s var(--spring)}
.count.on{transform:scale(1)}
.bump{animation:bump .55s var(--ease)}
@keyframes bump{40%{transform:scale(1.25) rotate(-8deg)}}

.btn{position:relative;overflow:hidden;border:none;cursor:pointer;padding:15px 32px;border-radius:999px;background:var(--acc);color:var(--accfg);font-weight:600;font-size:15px;display:inline-block;transition:transform .35s var(--spring),box-shadow .3s;box-shadow:inset 0 1px 1px rgba(255,255,255,.6),inset 0 -2px 6px rgba(0,0,0,.12)}
.btn:not(.ghost):not(.danger)::before{content:"";position:absolute;inset:0 0 50% 0;background:linear-gradient(180deg,rgba(255,255,255,.38),rgba(255,255,255,0));pointer-events:none;border-radius:inherit}
.btn:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.btn:active{transform:scale(.93)}
.btn:disabled{opacity:.4;pointer-events:none}
.btn.sm{padding:10px 18px;font-size:13px}
.ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:ripple .7s ease-out forwards;pointer-events:none;z-index:2}
html[data-theme=light] .pill .ripple,html[data-theme=light] .chip .ripple{background:rgba(0,0,0,.13)}
html[data-theme=dark] .btn .ripple,html[data-theme=dark] .chip.active .ripple{background:rgba(0,0,0,.22)}
@keyframes ripple{to{transform:scale(4);opacity:0}}

/* hero */
.hero{min-height:78vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:50px 5vw;perspective:900px}
.eyebrow{letter-spacing:4px;text-transform:uppercase;font-size:13px;color:var(--mut);margin-bottom:10px;animation:fade 1s .2s both}
.hero h1{font-size:clamp(70px,19vw,230px);line-height:.88;font-weight:700;letter-spacing:-4px;transition:transform .2s;direction:ltr}
.w{display:block}
.l{display:inline-block;animation:rise 1s var(--ease) both;animation-delay:var(--d);transition:transform .4s var(--ease)}
.l:hover{transform:translateY(-14px) rotate(-6deg)}
.out .l{color:transparent;-webkit-text-stroke:2px var(--fg)}
html[data-theme=dark] .out .l{-webkit-text-stroke:2px #c8c8d0;filter:drop-shadow(0 0 12px rgba(255,255,255,.35))}
.sub{max-width:520px;margin:26px 0 34px;color:var(--mut);font-size:18px;animation:fade 1s .9s both}
.hero .btn{animation:fade 1s 1.1s both}
@keyframes rise{from{transform:translateY(110%) rotate(8deg);opacity:0}to{transform:none;opacity:1}}
@keyframes fade{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

/* marquee */
.marquee{overflow:hidden;border-block:1px solid var(--line);padding:18px 0;direction:ltr}
.track{display:flex;width:max-content;animation:scroll 32s linear infinite}
.marquee:hover .track{animation-play-state:paused}
.track span{font-size:30px;font-weight:700;text-transform:uppercase;padding:0 28px;white-space:nowrap}
.track span:nth-child(even){color:transparent;-webkit-text-stroke:1px var(--fg)}
@keyframes scroll{to{transform:translateX(-50%)}}

/* shop */
main{padding:70px 5vw 40px;max-width:1300px;margin:auto}
main h2{font-size:clamp(30px,5vw,48px);margin-bottom:22px}
.reveal{opacity:0;transform:translateY(30px);transition:1s var(--ease)}
.reveal.in{opacity:1;transform:none}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{padding:11px 22px;border-radius:999px;border:none;cursor:pointer;position:relative;overflow:hidden;transition:transform .4s var(--spring),box-shadow .3s}
.chip:hover{transform:translateY(-4px)}
.chip:active{transform:scale(.92)}
.chip.active{background:var(--acc);color:var(--accfg);box-shadow:var(--shadow)}
.cats{max-height:0;opacity:0;overflow:hidden;transition:max-height .6s var(--ease),opacity .5s,margin .5s;padding:2px}
.cats.open{max-height:240px;opacity:1;margin-top:16px}
.cats .chip{font-size:14px;padding:8px 18px}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:22px;margin-top:34px}
.card{border-radius:26px;overflow:hidden;cursor:pointer;
  transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(var(--ty,0));
  transition:transform .25s ease-out,box-shadow .4s;animation:pop .8s var(--ease) backwards;animation-delay:calc(var(--i)*70ms)}
.card:hover{--ty:-8px}
@keyframes pop{from{opacity:0;transform:translateY(50px) scale(.9)}}
.card .img{position:relative;aspect-ratio:1;overflow:hidden;background:#fff;margin:7px;border-radius:20px}
.card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s var(--ease),filter .4s}
.card:hover img{transform:scale(1.1) rotate(1deg)}
.card .meta{padding:8px 18px 20px;position:relative;z-index:1}
.card small{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:1px}
.card h3{font-size:17px;margin:6px 0 10px;font-weight:600}
.price{font-weight:700;font-size:20px}
html[data-theme=dark] .price{background:var(--acc);-webkit-background-clip:text;background-clip:text;color:transparent}
.card.oos img{filter:grayscale(1) opacity(.45)}
.badge{position:absolute;top:12px;inset-inline-start:12px;background:#ff3b5c;color:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;animation:pulse 2s infinite}
@keyframes pulse{50%{transform:scale(1.08)}}
.add{position:absolute;bottom:12px;inset-inline-end:12px;z-index:2;width:44px;height:44px;border-radius:50%;border:none;background:var(--acc);color:var(--accfg);font-size:24px;line-height:1;cursor:pointer;display:grid;place-items:center;opacity:0;transform:translateY(14px) scale(.8);transition:transform .4s var(--spring),opacity .3s,box-shadow .3s}
.card:hover .add,.add:focus{opacity:1;transform:none}
.add:hover{transform:scale(1.15) rotate(90deg)!important;box-shadow:var(--shadow)}
.add:active{transform:scale(.85)!important}
@media(hover:none){.add{opacity:1;transform:none}}
.empty{text-align:center;padding:70px 0;color:var(--mut);font-size:18px}
.sk{height:330px;border-radius:24px;background:linear-gradient(100deg,var(--card) 30%,var(--line) 50%,var(--card) 70%);background-size:300% 100%;animation:sk 1.4s infinite}
@keyframes sk{to{background-position:-100% 0}}

footer{display:flex;flex-direction:column;align-items:center;gap:22px;padding:80px 5vw 150px}
#adminEntry{animation:fade .8s both,glowPulse 2.6s 1s infinite}
@keyframes glowPulse{50%{box-shadow:0 0 34px rgba(255,255,255,.55)}}

/* ================= DOCK ================= */
.dock{position:fixed;left:50%;bottom:calc(14px + env(safe-area-inset-bottom));z-index:60;width:222px;height:68px;border-radius:999px;direction:ltr;touch-action:none;
  transform:translateX(-50%);transition:width .65s var(--spring),transform .55s var(--spring)}
.dock::after{animation:spin 9s linear infinite}
@keyframes spin{to{--spin:360deg}}
.dock.refract{backdrop-filter:url(#lgf) blur(2px) saturate(1.9) brightness(1.15)}
html[data-theme=dark] .dock.refract{backdrop-filter:url(#lgf) blur(2px) saturate(1.9) brightness(1.5)}
.dock.press{transform:translateX(-50%) scale(1.07)}
.dock.searching{width:min(calc(100vw - 28px),460px)}
body.dashOpen .dock{transform:translateX(-50%) translateY(230%)}

.lens{position:absolute;top:6px;left:6px;width:70px;height:56px;border-radius:999px;z-index:1;pointer-events:none;
  background:linear-gradient(180deg,var(--lens1),var(--lens2));
  box-shadow:inset 0 1px 1px var(--ghi),inset 0 -1px 3px var(--glo),0 4px 14px var(--gsh);
  transform:translateX(calc(var(--i,0)*70px)) scale(var(--ls,1));transition:transform .6s var(--spring),opacity .3s}
.dock.press .lens{--ls:1.16}
.dock.searching .lens{opacity:0;transform:translateX(0) scale(.6)}

.dk-items{position:absolute;inset:6px;display:flex;z-index:1;transition:opacity .3s,transform .5s var(--spring)}
.dock.searching .dk-items{opacity:0;transform:scale(.8);pointer-events:none}
.dk{flex:0 0 70px;height:56px;border:none;background:transparent;border-radius:999px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--fg);opacity:.6;position:relative;transition:opacity .3s}
.dk svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .45s var(--spring);pointer-events:none}
.dk .lb{font-size:10px;font-weight:600;letter-spacing:.2px;pointer-events:none}
.dk.on{opacity:1}
.dk:active svg{transform:scale(.82)}
.dock.press .dk.on svg{transform:scale(1.14) translateY(-1px)}
.dk .count{top:2px;right:13px;inset-inline-end:auto}

.dk-search{position:absolute;inset:6px;display:flex;align-items:center;gap:10px;padding:0 6px 0 18px;z-index:1;opacity:0;transform:scale(.92);pointer-events:none;transition:opacity .35s .1s,transform .55s var(--spring)}
.dock.searching .dk-search{opacity:1;transform:none;pointer-events:auto}
.dk-search svg{width:21px;height:21px;stroke:var(--mut);fill:none;stroke-width:1.9;stroke-linecap:round;flex:none}
.dk-search input{flex:1;min-width:0;width:auto;border:none;background:transparent;box-shadow:none;padding:0;border-radius:0;font-size:16px;-webkit-appearance:none;appearance:none}
.dk-search input:focus{border:none;box-shadow:none}
.dk-search input::-webkit-search-cancel-button{display:none}
#qClose{flex:none;width:42px;height:42px;border-radius:50%;border:none;cursor:pointer;background:linear-gradient(180deg,var(--lens1),var(--lens2));box-shadow:inset 0 1px 1px var(--ghi);color:var(--fg);transition:transform .4s var(--spring)}
#qClose:active{transform:scale(.85)}

/* modal */
.modal{position:fixed;inset:0;z-index:70;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.42);opacity:0;pointer-events:none;transition:opacity .4s}
.modal.open{opacity:1;pointer-events:auto}
.mbox{position:relative;width:min(900px,100%);max-height:90vh;overflow:auto;display:grid;grid-template-columns:1fr 1fr;border-radius:32px;transform:scale(.85) translateY(40px);opacity:0;transition:transform .6s var(--spring),opacity .4s}
.modal.open .mbox{transform:none;opacity:1}
.mclose{position:absolute;top:14px;inset-inline-end:14px;z-index:4}
.mimg{background:#fff;min-height:300px;margin:8px;border-radius:24px;overflow:hidden;position:relative;z-index:1}
.mimg img{width:100%;height:100%;object-fit:cover;display:block}
.minfo{padding:36px 30px;display:flex;flex-direction:column;gap:14px;justify-content:center;position:relative;z-index:1}
.minfo small{color:var(--mut);text-transform:uppercase;letter-spacing:2px}
.minfo h2{font-size:30px}
.minfo p{color:var(--mut);line-height:1.7;white-space:pre-wrap}
.minfo .btn{align-self:flex-start;margin-top:6px}
.status{align-self:flex-start;display:inline-block;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:600}
.status.in{background:rgba(40,200,120,.15);color:#22c070}
.status.out{background:rgba(255,59,92,.15);color:#ff3b5c}

/* password */
.pwm{z-index:95}
.pwbox{width:min(380px,100%);padding:34px 28px 28px;border-radius:34px;text-align:center;display:grid;gap:12px;transform:scale(.85) translateY(30px);opacity:0;transition:transform .6s var(--spring),opacity .4s}
.pwm.open .pwbox{transform:none;opacity:1}
.pwbox>*{position:relative;z-index:1}
.lockico{width:62px;height:62px;margin:0 auto 4px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(180deg,var(--lens1),var(--lens2));box-shadow:inset 0 1px 1px var(--ghi),0 6px 18px var(--gsh)}
.lockico svg{width:28px;height:28px;stroke:var(--fg);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.pwbox h3{font-size:24px}
#pwForm{display:grid;gap:12px;margin-top:6px}
#pwIn{text-align:center;letter-spacing:2px}
.pwerr{min-height:20px;color:#ff3b5c;font-size:14px;font-weight:600}
.shake{animation:shake .5s}
@keyframes shake{20%,60%{transform:translateX(-10px)}40%,80%{transform:translateX(10px)}}

/* cart */
.ov{position:fixed;inset:0;z-index:44;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:opacity .4s}
.ov.open{opacity:1;pointer-events:auto}
.cart{position:fixed;top:10px;bottom:10px;inset-inline-end:10px;width:min(420px,calc(100% - 20px));z-index:45;border-radius:34px;overflow:hidden;display:flex;flex-direction:column;transform:translateX(118%);transition:transform .65s var(--ease)}
html[dir=rtl] .cart{transform:translateX(-118%)}
.cart.open{transform:none!important}
.chead{display:flex;justify-content:space-between;align-items:center;padding:18px 20px 14px 24px;border-bottom:1px solid var(--line);position:relative;z-index:1}
#cartItems{flex:1;overflow:auto;padding:8px 22px;position:relative;z-index:1}
.cempty{text-align:center;color:var(--mut);padding:70px 0;font-size:17px}
.ci{display:flex;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);animation:fade .5s both}
.ci img{width:66px;height:66px;border-radius:14px;object-fit:cover;background:#fff}
.inf{flex:1;min-width:0}
.inf h4{font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inf .u{color:var(--mut);font-size:13px;margin-top:2px}
.qty{display:inline-flex;align-items:center;gap:12px;margin-top:8px}
.qty button{width:28px;height:28px;border-radius:50%;border:1px solid var(--line);background:transparent;cursor:pointer;transition:transform .35s var(--spring),border-color .3s}
.qty button:hover{transform:scale(1.2);border-color:var(--accs)}
.qty button:active{transform:scale(.85)}
.qty b{min-width:18px;text-align:center}
.rm{border:none;background:transparent;color:#ff3b5c;cursor:pointer;font-size:18px;transition:transform .3s}
.rm:hover{transform:rotate(90deg) scale(1.25)}
#cartFoot{padding:18px 22px calc(100px + env(safe-area-inset-bottom));display:grid;gap:10px;position:relative;z-index:1}
#cartFoot:empty{padding:0}
.tr{display:flex;justify-content:space-between;gap:10px}
.tr.tot{font-weight:700;font-size:20px;padding-top:6px;border-top:1px dashed var(--line)}
.dnote{font-size:13px;color:var(--mut)}
#cartFoot .btn{width:100%;text-align:center}
.fly{position:fixed;z-index:100;border-radius:14px;object-fit:cover;pointer-events:none}

/* dashboard */
.dash{position:fixed;inset:0;z-index:80;overflow:auto;background:var(--bg);transform:translateY(100%);transition:transform .7s var(--ease)}
html[data-theme=dark] .dash{background:rgba(0,0,0,.82)}
.dash.open{transform:none}
.dash-in{max-width:900px;margin:auto;padding:30px 5vw 80px}
.dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}
.panel{border-radius:28px;padding:26px;margin-bottom:24px;animation:fade .7s both}
.panel>*{position:relative;z-index:1}
.panel h3{margin-bottom:18px;font-size:20px}
.row{display:flex;gap:10px}
.form{display:grid;gap:12px}
input,select,textarea{width:100%;padding:14px 16px;border-radius:16px;border:1px solid var(--line);background:transparent;outline:none;transition:border-color .3s,box-shadow .3s}
input:focus,select:focus,textarea:focus{border-color:var(--accs);box-shadow:0 0 0 4px color-mix(in srgb,var(--accs) 20%,transparent)}
option{background:var(--bg);color:var(--fg)}
.drop{border:2px dashed var(--line);border-radius:20px;min-height:150px;display:grid;place-items:center;cursor:pointer;padding:14px;text-align:center;color:var(--mut);transition:border-color .3s,transform .3s}
.drop:hover,.drop.over{border-color:var(--accs);transform:scale(1.01)}
.drop img{max-height:230px;max-width:100%;border-radius:12px}
.bitem{border:1px solid var(--line);border-radius:20px;padding:16px;margin-top:14px;animation:fade .5s both}
.bhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.mini{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.mini em{color:var(--mut);font-size:14px}
.tag{display:inline-flex;align-items:center;gap:8px;padding:6px 8px 6px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:14px}
.tag button{border:none;background:transparent;cursor:pointer;color:#ff3b5c;transition:transform .3s}
.tag button:hover{transform:rotate(90deg) scale(1.3)}
.danger{background:transparent!important;color:#ff3b5c!important;border:1px solid #ff3b5c!important}
.ghost{background:transparent!important;color:var(--fg)!important;border:1px solid var(--line)!important}
.prow{display:flex;align-items:center;gap:14px;padding:12px;border:1px solid var(--line);border-radius:18px;margin-top:12px;flex-wrap:wrap;animation:fade .5s both}
.prow img{width:60px;height:60px;border-radius:12px;object-fit:cover}
.pinfo{flex:1;min-width:150px}
.pinfo small{color:var(--mut)}
.acts{display:flex;gap:8px;flex-wrap:wrap}

#toasts{position:fixed;bottom:calc(100px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:120;display:grid;gap:8px;width:max-content;max-width:92vw;pointer-events:none}
.toast{padding:12px 22px;border-radius:999px;color:var(--fg);font-weight:600;text-align:center;animation:toast .5s var(--spring),fade .4s 2.8s reverse forwards}
.toast>*{position:relative;z-index:1}
.toast.err{background:#ff3b5c;color:#fff}
@keyframes toast{from{transform:translateY(40px) scale(.8);opacity:0}}

/* theme circle reveal */
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
::view-transition-new(root){animation:vt .9s ease-in-out both;z-index:9999}
@keyframes vt{from{clip-path:circle(0 at var(--vx,50%) var(--vy,0))}to{clip-path:circle(150vmax at var(--vx,50%) var(--vy,0))}}

@media(max-width:700px){.mbox{grid-template-columns:1fr}.top nav{display:none}.row{flex-direction:column}.logo{font-size:18px;letter-spacing:2px}.pill{padding:0 10px;min-width:38px;height:38px}.tools{gap:6px}.top{padding:7px 8px 7px 18px}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}